<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat is the base because AppCompatDelegate.setApplicationLocales
         (the per-app locale backport) requires an AppCompat activity. Everything
         visible is drawn by Compose; this theme only sets the window. -->
    <style name="Theme.Moonlight" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/ml_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The launch theme. Also the theme the system uses for the starting window
         when the app is restarted by a language change, which is why its
         background is a day/night resource rather than a fixed colour. -->
    <style name="Theme.Moonlight.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ml_window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ml_splash_icon_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Moonlight</item>
    </style>
</resources>
